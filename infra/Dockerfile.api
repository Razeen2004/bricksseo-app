FROM node:22-alpine

# Prisma detects the OpenSSL version by running the `openssl` binary; without it, it falls back to 1.1.x and loads the wrong engine
RUN apk add --no-cache openssl

WORKDIR /app

# Copy root package.json and lockfile
COPY package*.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/

# Install dependencies (only production for API)
RUN npm install -w apps/api -w packages/shared --omit=dev

# Copy API and Shared source code
COPY packages/shared packages/shared
COPY apps/api apps/api

WORKDIR /app/apps/api

# Generate Prisma client
RUN npx prisma generate

EXPOSE 4000
CMD ["npm", "run", "start"]
