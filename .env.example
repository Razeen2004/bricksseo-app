# 32 random bytes, base64 encoded
APP_ENCRYPTION_KEYS=v1:q1M5R8P9xY2Z8T4xV7H9W4U5M2X1N3R9Q4T6H7V3Y2w=
LICENSE_KEY_PEPPER=this_is_a_32_character_long_secret_pepper_for_hmac
